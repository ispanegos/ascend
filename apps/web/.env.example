# Local: values printed by `supabase start` (or `supabase status`).
# Production: set in Vercel project settings.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never NEXT_PUBLIC_). Used solely to persist Stats Engine results
# through public.engine_record_calculation (ADR-024). Local: `supabase status`.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Where the Python Stats Engine runs. Unset: run it locally as a
# subprocess (`python3 -m ascend_engine`) from ../../engine.
# ASCEND_ENGINE_URL=http://127.0.0.1:8765
# ASCEND_ENGINE_PYTHON=python3
